# --- Mesure du CTR sortant -------------------------------------------------
# Le clic sortant est compté CÔTÉ SERVEUR par /go/[id] : c'est la source de
# vérité (insensible aux bloqueurs de scripts). Sans PLAUSIBLE_DOMAIN, aucun
# clic n'est mesuré — l'événement est seulement journalisé en avertissement.

# Domaine déclaré dans Plausible, pour le script navigateur (pages vues).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Domaine utilisé par l'envoi serveur. Laisse vide pour reprendre la valeur
# ci-dessus.
PLAUSIBLE_DOMAIN=

# Instance Plausible. Par défaut https://plausible.io ; à changer si tu
# auto-héberges.
PLAUSIBLE_HOST=

# Mets 1 si ton plan Plausible n'inclut PAS les propriétés personnalisées.
# Chaque clic émet alors un second événement nommé par univers et par CTA
# (ex. outbound_click_furniture_quote), ce qui rend l'hypothèse H2 lisible
# sur tous les plans. Coût : un événement facturé de plus par clic.
PLAUSIBLE_SEGMENTED_EVENTS=

# --- Page produit de repli --------------------------------------------------
# Adresse affichée sur /p/[id] tant que la boutique n'est pas ouverte. Sans
# elle, le visiteur intéressé n'a aucun moyen de te joindre.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Vidéo (ADR-02 : Bunny Stream) -----------------------------------------
# Publiques : servent uniquement à construire les URL de lecture, aucun secret.
NEXT_PUBLIC_VIDEO_CDN_HOST=          # ex. vz-xxxxxxx.b-cdn.net (pull zone)
NEXT_PUBLIC_VIDEO_LIBRARY_ID=        # identifiant de la bibliothèque

# Secrètes : téléversement depuis la France. Ne jamais exposer côté client —
# lib/video-admin.ts est protégé par `server-only`.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=

# Tests d'intégration uniquement : redirige les appels vers un faux serveur.
# Laisser vide en production.
BUNNY_API_BASE=

# --- Identité publique du site -------------------------------------------
# Sert aux métadonnées de partage : Open Graph exige des URL ABSOLUES, une URL
# relative est ignorée en silence par les réseaux sociaux — l'aperçu partagé
# apparaît alors sans image, sans message d'erreur.
# Sur Vercel, VERCEL_PROJECT_PRODUCTION_URL prend le relais si celle-ci est
# absente ; en dernier recours le code retombe sur https://shorts.shiipiit.com.
NEXT_PUBLIC_SITE_URL=                 # ex. https://shorts.shiipiit.com

# --- Formulaire de rétractation --------------------------------------------
# Obligation légale applicable depuis le 19 juin 2026 (L. 221-21 du code de la
# consommation) : la déclaration doit être accusée « sans délai ».
#
# Origine autorisée à appeler la route (la boutique Shopify, une fois ouverte).
# Vide = seules les requêtes de même origine passent.
RETRACTATION_ALLOWED_ORIGIN=          # ex. https://shiipiit.com

# Destinataire interne de la notification de rétractation.
RETRACTATION_NOTIFY_TO=

# Envoi de l'accusé de réception. Sans clé, la déclaration est enregistrée mais
# le consommateur ne reçoit rien — ce qui est une NON-CONFORMITÉ, pas une simple
# dégradation : l'accusé de réception est l'obligation elle-même.
RESEND_API_KEY=
RESEND_FROM=                          # ex. "shiipiit <contact@shiipiit.com>"
