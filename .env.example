# --- Mesure du CTR sortant -------------------------------------------------
# Le clic sortant est compté CÔTÉ SERVEUR par /go/[id] : c'est la source de
# vérité (insensible aux bloqueurs de scripts). Sans PLAUSIBLE_DOMAIN, aucun
# clic n'est mesuré — l'événement est seulement journalisé en avertissement.

# Domaine déclaré dans Plausible, pour le script navigateur (pages vues).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Domaine utilisé par l'envoi serveur. Laisse vide pour reprendre la valeur
# ci-dessus.
PLAUSIBLE_DOMAIN=

# Instance Plausible. Par défaut https://plausible.io ; à changer si tu
# auto-héberges.
PLAUSIBLE_HOST=

# Mets 1 si ton plan Plausible n'inclut PAS les propriétés personnalisées.
# Chaque clic émet alors un second événement nommé par univers et par CTA
# (ex. outbound_click_furniture_quote), ce qui rend l'hypothèse H2 lisible
# sur tous les plans. Coût : un événement facturé de plus par clic.
PLAUSIBLE_SEGMENTED_EVENTS=

# --- Page produit de repli --------------------------------------------------
# Adresse affichée sur /p/[id] tant que la boutique n'est pas ouverte. Sans
# elle, le visiteur intéressé n'a aucun moyen de te joindre.
NEXT_PUBLIC_CONTACT_EMAIL=
